{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/download",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(iPhone|iPod).*"
        }
      ],
      "destination": "https://apps.apple.com/app/id6772970281",
      "permanent": false
    },
    {
      "source": "/download",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*Android.*"
        }
      ],
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*HuaweiBrowser.*"
        }
      ],
      "destination": "https://play.google.com/store/apps/details?id=com.recomly.app",
      "permanent": false
    },
    {
      "source": "/business/download",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(iPhone|iPod).*"
        }
      ],
      "destination": "https://apps.apple.com/app/id6835423379",
      "permanent": false
    },
    {
      "source": "/business/download",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*Android.*"
        }
      ],
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*HuaweiBrowser.*"
        }
      ],
      "destination": "https://play.google.com/store/apps/details?id=com.recomly.business",
      "permanent": false
    },
    {
      "source": "/r/:code",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*Android.*"
        }
      ],
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*HuaweiBrowser.*"
        }
      ],
      "destination": "https://play.google.com/store/apps/details?id=com.recomly.app&referrer=utm_source%3Dreferral%26utm_medium%3Dcode%26utm_campaign%3D:code",
      "permanent": false
    },
    {
      "source": "/v/:code",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*Android.*"
        }
      ],
      "destination": "https://play.google.com/store/apps/details?id=com.recomly.business",
      "permanent": false
    },
    {
      "source": "/v/:code",
      "destination": "https://apps.apple.com/app/id6835423379",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/r/:code",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(iPhone|iPod).*"
        }
      ],
      "destination": "/invite"
    },
    {
      "source": "/r/:code",
      "destination": "/download"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/(apple-app-site-association|assetlinks.json)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
