{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/download",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(iPhone|iPod).*" }],
      "destination": "https://apps.apple.com/app/id6772970281",
      "permanent": false
    },
    {
      "source": "/download",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*Android.*" }],
      "missing": [{ "type": "header", "key": "user-agent", "value": ".*HuaweiBrowser.*" }],
      "destination": "https://play.google.com/store/apps/details?id=com.recomly.app",
      "permanent": false
    },
    {
      "source": "/r/:code",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(iPhone|iPod).*" }],
      "destination": "https://apps.apple.com/app/apple-store/id6772970281?pt=128929183&ct=:code&mt=8",
      "permanent": false
    },
    {
      "source": "/r/:code",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*Android.*" }],
      "missing": [{ "type": "header", "key": "user-agent", "value": ".*HuaweiBrowser.*" }],
      "destination": "https://play.google.com/store/apps/details?id=com.recomly.app&referrer=utm_source%3Dreferral%26utm_medium%3Dcreator%26utm_campaign%3D:code",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/r/:code", "destination": "/download.html" }
  ]
}
